gcp_project_id = "your-gcp-project-id"
gcp_region     = "us-central1"
environment    = "prod"
cluster_name   = "nexus-iq-ha"   # distinct per deployment when several sizes share one project

public_subnet_cidr   = "10.100.1.0/24"
private_subnet_cidrs = ["10.100.10.0/24", "10.100.11.0/24", "10.100.12.0/24"]
gke_pods_cidr        = "10.101.0.0/16"
gke_services_cidr    = "10.102.0.0/16"
gke_master_cidr      = "172.16.0.0/28"

node_instance_type           = "n4a-highmem-8"
node_group_min_size          = 2
node_group_max_size          = 5
node_group_desired_size      = 3
node_disk_size               = 100
gke_maintenance_window_start = "03:00"

postgres_version                   = "POSTGRES_18"
db_instance_tier                   = "db-custom-8-30720"
db_availability_type               = "REGIONAL"
db_disk_size                       = 256
db_max_disk_size                   = 1000
db_max_connections                 = "400"
db_backup_start_time               = "03:00"
db_transaction_log_retention_days  = 7
db_backup_retention_count          = 8
db_maintenance_window_day          = 7
db_maintenance_window_hour         = 3
db_deletion_protection             = false
enable_read_replica                = true
db_name                            = "nexusiq"
db_username                        = "nexusiq"
db_password                        = "CHANGE_ME_STRONG_PASSWORD"

filestore_zone        = "us-central1-a"
filestore_tier        = "BASIC_HDD"
filestore_capacity_gb = 2560

log_retention_days               = 7
enable_monitoring_alerts         = true
cloud_armor_rate_limit_threshold = 1000

nexus_iq_replica_count  = 3
nexus_iq_admin_password = "admin123"
helm_chart_version      = "201.0.0"

# Search Backend
# "lucene" (default) uses the built-in index and needs nothing else running.
# "opensearch" points Nexus IQ Server at an OpenSearch cluster you run yourself. Google Cloud has
# no managed OpenSearch service, so this configuration does not create one: build the cluster to
# the specification in README.md, "Search Backend", and name its host here.
search_engine = "lucene"

# opensearch_endpoint                 = "opensearch.internal.example.com"
# opensearch_port                     = 9200
# opensearch_use_tls                  = true
# opensearch_username                 = "nexusiq"
# opensearch_password                 = "CHANGE_ME_STRONG_PASSWORD"
# opensearch_index_replicas = 1
# Only for a private certificate authority:
# opensearch_ca_certificate = <<-EOT
#   -----BEGIN CERTIFICATE-----
#   ...the authority's PEM certificate...
#   -----END CERTIFICATE-----
# EOT
