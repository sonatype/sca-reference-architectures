# AWS Configuration
aws_region  = "us-east-1"
environment = "prod"

# Cluster Configuration
cluster_name = "nexus-iq-ha"
vpc_cidr     = "10.0.0.0/16"

# EKS Configuration
kubernetes_version       = "1.36"
node_instance_type      = "r9g.2xlarge"
node_group_min_size     = 2
node_group_max_size     = 5
node_group_desired_size = 3
node_disk_size          = 50

# RDS Aurora Configuration
aurora_engine_version   = "18.6"
aurora_instance_class   = "db.r8g.2xlarge"
aurora_instance_count   = 2
database_name           = "nexusiq"
database_username       = "nexusiq"
database_password       = "CHANGE_ME_STRONG_PASSWORD"
backup_retention_period = 7
skip_final_snapshot     = false
deletion_protection     = true

# Nexus IQ Server Configuration
nexus_iq_license       = ""
nexus_iq_admin_password = "admin123"
nexus_iq_replica_count = 3

# Pod CPU, memory and heap are Helm chart settings, not Terraform inputs.
# Set iq_server.resources and iq_server.javaOpts in helm-values.yaml.

# Helm Configuration
helm_chart_version = "201.0.0"

# Logging Configuration
enable_fluentd        = true
enable_cloudwatch_logs = true

# Ingress Configuration
enable_ingress_nginx = true
ingress_hostname     = "nexus-iq.yourdomain.com"
ingress_tls_enabled  = false
acm_certificate_arn  = ""

# Pod autoscaling is set by hpa.* in helm-values.yaml.

# Search backend. "lucene" (default) uses IQ Server's built-in index; "opensearch"
# creates a domain here. The domain carries prevent_destroy; README.md gives the
# teardown steps, and the account needs the OpenSearch service-linked role:
#   aws iam create-service-linked-role \
#     --aws-service-name opensearchservice.amazonaws.com
search_engine = "lucene"

# Domain shape by size, two data nodes at every size, one in each of this root's
# two zones. Three nodes need a third private subnet in main.tf.
#
# M (2,000 - 10,000 apps):
# opensearch_instance_type           = "m8g.large.search"
# opensearch_volume_size_gb          = 100
# opensearch_dedicated_master_type   = "m8g.medium.search"
#
# L (10,000 - 20,000 apps):
# opensearch_instance_type           = "m8g.xlarge.search"
# opensearch_volume_size_gb          = 150
# opensearch_dedicated_master_type   = "m8g.medium.search"
#
# XL (20,000 - 80,000 apps):
# opensearch_instance_type           = "r8g.2xlarge.search"
# opensearch_volume_size_gb          = 250
# opensearch_dedicated_master_type   = "m8g.large.search"
#
# Every size:
# opensearch_instance_count          = 2
# opensearch_availability_zone_count = 2
# opensearch_index_replicas          = 1
#
# An account at the region's 10 log resource policies writes one shared policy
# and sets this false:
# opensearch_create_log_resource_policy = false
#
# To use a domain you already run, set these two instead and nothing is created:
# opensearch_domain_endpoint = "CHANGE_ME-search-domain.us-east-1.es.amazonaws.com"
# opensearch_domain_name     = "CHANGE_ME-search-domain"

# Extra tags on the search backend's resources. Keep the keys lowercase, since AWS
# compares tag keys case-insensitively. Put real values in terraform.tfvars.
# common_tags = {
#   owner      = "CHANGE_ME_EMAIL"
#   project    = "CHANGE_ME_PROJECT"
#   subproject = "CHANGE_ME_SUBPROJECT"
#   department = "CHANGE_ME_DEPARTMENT"
#   team       = "CHANGE_ME_TEAM"
# }
