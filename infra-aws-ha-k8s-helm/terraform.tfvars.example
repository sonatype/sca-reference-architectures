# AWS Configuration
aws_region  = "us-east-1"
environment = "prod"

# Cluster Configuration
cluster_name = "nexus-iq-ha"
vpc_cidr     = "10.0.0.0/16"

# EKS Configuration
kubernetes_version       = "1.30"
node_instance_type      = "m5d.2xlarge"
node_group_min_size     = 2
node_group_max_size     = 5
node_group_desired_size = 3
node_disk_size          = 50

# RDS Aurora Configuration
aurora_engine_version   = "15.19"
aurora_instance_class   = "db.r6g.4xlarge"
aurora_instance_count   = 2
database_name           = "nexusiq"
database_username       = "nexusiq"
database_password       = "CHANGE_ME_STRONG_PASSWORD"
backup_retention_period = 7
skip_final_snapshot     = false
deletion_protection     = true

# EFS Configuration
efs_provisioned_throughput = 100

# Nexus IQ Server Configuration
nexus_iq_version       = "1.195.0"
nexus_iq_license       = ""
nexus_iq_admin_password = "admin123"
nexus_iq_replica_count = 3

# Resource Limits (adjusted for node capacity)
nexus_iq_memory_request = "16Gi"
nexus_iq_memory_limit   = "24Gi"
nexus_iq_cpu_request    = "4"
nexus_iq_cpu_limit      = "6"

# Helm Configuration
helm_chart_version = "195.0.0"
helm_namespace     = "nexus-iq"

# Logging Configuration
enable_fluentd        = true
enable_cloudwatch_logs = true

# Ingress Configuration
enable_ingress_nginx = true
ingress_hostname     = "nexus-iq.yourdomain.com"
ingress_tls_enabled  = false
acm_certificate_arn  = ""

# Pod autoscaling is a Helm chart setting, not a Terraform input.
# Set hpa.enabled, hpa.minReplicas and hpa.maxReplicas in helm-values.yaml.

# Search Backend (optional)
# "lucene" (default) uses the index built into IQ Server and needs nothing else.
# "opensearch" creates an AWS-managed domain here and points IQ Server at it.
# The domain carries prevent_destroy, so a teardown needs
# `terraform state rm aws_opensearch_domain.nexus_one` first. See the
# OpenSearch section of README.md before switching.
search_engine = "lucene"

# Domain shape, by the size you picked above. Starting points, not measured
# results: the per-size sizing is CLM-55930. Three data nodes at every size,
# the smallest count that both places a replica and spreads across three zones.
#
# M (2,000 - 10,000 apps):
# opensearch_instance_type           = "m8g.large.search"
# opensearch_volume_size_gb          = 50
# opensearch_dedicated_master_type   = "m8g.medium.search"
#
# L (10,000 - 20,000 apps):
# opensearch_instance_type           = "m8g.xlarge.search"
# opensearch_volume_size_gb          = 100
# opensearch_dedicated_master_type   = "m8g.medium.search"
#
# XL (20,000 - 80,000 apps):
# opensearch_instance_type           = "m8g.2xlarge.search"
# opensearch_volume_size_gb          = 100
# opensearch_dedicated_master_type   = "m8g.large.search"
#
# Every size:
# opensearch_instance_count          = 3
# opensearch_availability_zone_count = 3
# opensearch_index_replicas          = 1
#
# To use a domain you already run, set these two instead of the shape above and
# nothing is created:
# opensearch_domain_endpoint = "search-my-domain-abc123.us-east-1.es.amazonaws.com"
# opensearch_domain_name     = "my-domain"

# Extra tags merged onto the resources the search backend creates.
# Keep the keys lowercase: AWS treats tag keys as case-insensitive when it
# checks for duplicates, so a key differing only in case from one already set
# fails the apply. Every value below names a deployment or a person, so put the
# real ones in terraform.tfvars, which is gitignored, and leave this file with
# placeholders.
# common_tags = {
#   owner      = "REPLACE-ME@example.com"
#   project    = "REPLACE-ME"
#   subproject = "REPLACE-ME"
#   department = "REPLACE-ME"
#   team       = "REPLACE-ME"
# }
