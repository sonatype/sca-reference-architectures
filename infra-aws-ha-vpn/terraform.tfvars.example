# Copy this file to terraform.tfvars and update the values
# cp terraform.tfvars.example terraform.tfvars

# ================================
# GENERAL CONFIGURATION
# ================================
aws_region   = "us-east-1"
cluster_name = "ref-arch-iq-ha-vpn-cluster"
environment  = "dev" # one of: dev, staging, prod (used for CloudConnexa network tagging)

# ================================
# NETWORK CONFIGURATION
# ================================
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs   = ["10.0.10.0/24", "10.0.20.0/24", "10.0.30.0/24"]
db_subnet_cidrs        = ["10.0.40.0/24", "10.0.50.0/24", "10.0.60.0/24"]
enable_nat_gateway     = true

# ================================
# ECS CONFIGURATION — Size XL (16 vCPU / 128 GB per node, 4 nodes)
# ================================
ecs_cpu                 = 16384  # 16 vCPU
ecs_memory              = 131072 # 128 GB
ecs_memory_reservation  = 98304  # 96 GB soft limit

# ================================
# IQ SERVER CONFIGURATION — Size XL
# ================================
iq_desired_count        = 4  # 4 nodes for XL
iq_min_count           = 3  # Minimum for auto scaling
iq_max_count           = 5  # Maximum for auto scaling
iq_cpu_target_value    = 70  # CPU target for auto scaling (%)
iq_memory_target_value = 80  # Memory target for auto scaling (%)
iq_docker_image        = "sonatype/nexus-iq-server:latest"
java_opts              = "-Xms96g -Xmx96g -XX:MaxDirectMemorySize=8g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/sonatype-work/Java_Heap_logs -XX:+CrashOnOutOfMemoryError -Dinsight.threads.monitor=10 -Djava.util.prefs.userRoot=/sonatype-work/javaprefs"

# ================================
# DATABASE CONFIGURATION (Aurora PostgreSQL) — Size XL
# ================================
db_name                     = "nexusiq"
db_username                 = "nexusiq"
db_password                 = "YourSecurePassword123!"  # CHANGE THIS!
aurora_engine_version       = "15.10"
aurora_instance_class       = "db.r6g.4xlarge"  # 16 vCPU, 128 GB
aurora_instances            = 2  # Minimum 2 for HA
db_backup_retention_period  = 7
db_backup_window           = "03:00-04:00"
db_maintenance_window      = "sun:04:00-sun:05:00"
db_skip_final_snapshot     = false  # Set to true for development
db_deletion_protection     = false  # Set to false for development

# ================================
# LOAD BALANCER CONFIGURATION
# ================================
# The ALB in this variant is always internal (see load_balancer.tf) — there
# is no public listener regardless of this setting. An SSL certificate is
# still recommended so that CloudConnexa VPN clients reach IQ Server over
# HTTPS rather than plain HTTP.
# ssl_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"
alb_deletion_protection = false  # Set to true for production

# ================================
# EFS CONFIGURATION
# ================================
efs_throughput_mode                  = "provisioned"
efs_provisioned_throughput_in_mibps = 100

# ================================
# MONITORING CONFIGURATION
# ================================
enable_container_insights = true
enable_prometheus        = true
log_retention_days       = 30

# ================================
# CLOUDCONNEXA VPN CONFIGURATION
# ================================
# Requires CLOUDCONNEXA_CLIENT_ID and CLOUDCONNEXA_CLIENT_SECRET environment
# variables to be set before running terraform (the OpenVPN/cloudconnexa
# provider reads these directly from the environment, they are not
# Terraform variables). Requires access to Sonatype's private Terraform
# Cloud module registry (app.terraform.io/Sonatype-Cloud/...).
create_cloudconnexa             = true
cloudconnexa_base_url           = "https://sonatype.api.openvpn.com"
cloudconnexa_connector_count    = 2  # 2+ for connector redundancy
cloudconnexa_connector_version  = "1"
cloudconnexa_segment            = "iq-server"
cloudconnexa_product            = "iq-server-perf-test"
cloudconnexa_owner              = "your-team@sonatype.com"  # CHANGE THIS!
# cloudconnexa_application_domain = "iq-perf-test.example.internal"  # optional, defaults to the ALB's own DNS name
cloudconnexa_client_cidr_blocks = ["10.0.0.0/16"]  # verify against your CloudConnexa network's client/route CIDR

# ================================
# COMMON TAGS
# ================================
common_tags = {
  Project     = "nexus-iq-server-ha-vpn"
  Environment = "production"  # or "development", "staging"
  Terraform   = "true"
  Owner       = "platform-team"
  CostCenter  = "engineering"
}

# ================================
# SECURITY NOTES
# ================================
# 1. Change the db_password to a strong, unique password
# 2. Consider using AWS Secrets Manager rotation for the database password
# 3. Provide an SSL certificate ARN for HTTPS termination between VPN clients and the ALB
# 4. Verify cloudconnexa_client_cidr_blocks matches your CloudConnexa network's actual client/route CIDR
# 5. Enable deletion protection for production resources
# 6. Use specific Docker image tags rather than "latest" in production
# 7. This environment has NO public internet path by design — do not add a
#    0.0.0.0/0 ingress rule to the ALB security group, or you will defeat the
#    purpose of this variant. Use infra-aws-ha instead if public access is
#    actually desired.

# ================================
# COST OPTIMIZATION NOTES
# ================================
# 1. ECS Fargate pricing based on vCPU and memory usage
# 2. Adjust backup retention periods based on requirements
# 3. Use burstable EFS throughput mode if consistent high throughput isn't needed
# 4. CloudConnexa connector instances and NAT gateways both incur additional
#    hourly + data processing charges on top of the base infra-aws-ha cost

# ================================
# HIGH AVAILABILITY NOTES
# ================================
# 1. 4 IQ Server tasks by default (iq_desired_count = 4, Size XL)
# 2. Minimum 2 Aurora instances (aurora_instances = 2)
# 3. ECS tasks run across multiple Availability Zones
# 4. Auto scaling based on CPU and memory utilization
# 5. Service discovery for inter-task communication
# 6. Shared EFS storage for stateful data
# 7. 2+ CloudConnexa connector instances for VPN connector redundancy
