# Copy this file to terraform.tfvars and update the values
# cp terraform.tfvars.example terraform.tfvars

# General Configuration
gcp_project_id = "your-gcp-project-id"
gcp_region     = "us-central1"
gcp_zone       = "us-central1-a"
environment    = "dev"

# Resource Naming
# Prefix for every name that must be unique in a project. Empty keeps the default
# names; set a distinct value per deployment when several share one project, for example "iq-xs".
cluster_name = ""

# Network Configuration
# This root creates subnets inside an auto-created VPC, so there is no
# VPC-wide CIDR variable. Set the three subnet ranges instead.
public_subnet_cidr  = "10.100.1.0/24"
private_subnet_cidr = "10.100.10.0/24"
db_subnet_cidr      = "10.100.20.0/24"

# GCE with Docker Configuration
gce_machine_type   = "n4a-highmem-8"
gce_boot_image     = ""  # Empty picks Debian 12 for the machine type's architecture
gce_boot_disk_size = 100
iq_desired_count   = 1
iq_docker_image    = "sonatype/nexus-iq-server:latest"
java_opts          = "-Xms48g -Xmx48g -XX:MaxDirectMemorySize=8g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/sonatype-work/Java_Heap_logs -XX:+CrashOnOutOfMemoryError -Dinsight.threads.monitor=10 -Djava.util.prefs.userRoot=/sonatype-work/javaprefs"

# Database Configuration
db_name                             = "nexusiq"
db_username                         = "nexusiq"
db_password                         = "CHANGE_ME_STRONG_PASSWORD"  # Change this!
# Cloud SQL cannot downgrade a major version in place. If an instance already exists
# on another major version, set that version here.
postgres_version                    = "POSTGRES_18"
db_instance_tier                    = "db-custom-N4-8-65536"  # 8 vCPU, 64 GB, N4 series
db_edition                          = "ENTERPRISE"
db_disk_type                        = "HYPERDISK_BALANCED"    # PD_SSD with the XS and S db-custom-2-* tiers
db_disk_provisioned_iops            = 8000                    # used only on HYPERDISK_BALANCED
db_availability_type                = "ZONAL"
db_disk_size                        = 128
db_max_disk_size                    = 500
db_backup_start_time                = "03:00"
db_max_connections                  = "200"
db_transaction_log_retention_days   = 7
db_backup_retention_count           = 8
db_maintenance_window_day           = 7
db_maintenance_window_hour          = 4
db_deletion_protection              = false

# Storage Configuration
filestore_zone        = "us-central1-a"
filestore_tier        = "BASIC_HDD"
filestore_capacity_gb = 1024

# Load Balancer Configuration
enable_ssl  = false  # Set to true and provide domain_name for HTTPS
domain_name = ""     # Required if enable_ssl is true (e.g., "iq.example.com")

# Search Backend, needed for Advanced Search and the Nexus One index at every size
# "lucene" (default) uses the built-in index. "opensearch" names an OpenSearch cluster
# you run yourself; build it to README.md, "Search Backend".
search_engine = "lucene"

# opensearch_endpoint                 = "opensearch.internal.example.com"
# opensearch_port                     = 9200
# opensearch_use_tls                  = true
# opensearch_username                 = "nexusiq"
# opensearch_password                 = "CHANGE_ME_STRONG_PASSWORD"
# opensearch_index_replicas = 1  # 1 for three data nodes at M, 0 for one at XS and S
# Only for a private certificate authority:
# opensearch_ca_certificate = <<-EOT
#   -----BEGIN CERTIFICATE-----
#   ...the authority's PEM certificate...
#   -----END CERTIFICATE-----
# EOT
