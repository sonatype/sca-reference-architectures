# Copy this file to terraform.tfvars and update the values                                                                                                                                                                                                                  
# cp terraform.tfvars.example terraform.tfvars
 
# General Configuration
aws_region  = "us-east-1"
 
# Base name for every resource this creates. Give each deployment its own value
# to run more than one in a single AWS account, one per size for example.
cluster_name = "ref-arch"
 
# Network Configuration
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs   = ["10.0.10.0/24", "10.0.20.0/24"]
db_subnet_cidrs        = ["10.0.30.0/24", "10.0.40.0/24"]
 
# ECS Configuration
ecs_cpu           = 8192  # 8 vCPU
ecs_memory        = 32768 # 32 GB
iq_desired_count  = 1 # Single instance (recommended)
iq_docker_image   = "sonatype/nexus-iq-server:latest"
java_opts         = "-Xms24g -Xmx24g -XX:+UseG1GC -Djava.util.prefs.userRoot=/sonatype-work/javaprefs"
 
# Database Configuration
db_name                     = "nexusiq"
db_username                 = "nexusiq"
db_password                 = "CHANGE_ME_STRONG_PASSWORD"  # Change this!
db_instance_class           = "db.r6g.4xlarge"
db_allocated_storage        = 500
db_max_allocated_storage    = 1000
postgres_version            = "15.19"
db_backup_retention_period  = 7 
db_backup_window           = "03:00-04:00"
db_maintenance_window      = "sun:04:00-sun:05:00"
db_skip_final_snapshot     = true
db_deletion_protection     = false
 
# Load Balancer Configuration
# ssl_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"
alb_deletion_protection = false
 
# Logging Configuration
log_retention_days = 30

# Search Backend (optional)
# "lucene" (default) uses the index built into IQ Server and needs nothing else.
# "opensearch" creates an AWS-managed domain here and points IQ Server at it.
# The domain carries prevent_destroy, so a teardown needs
# `terraform state rm aws_opensearch_domain.nexus_one` first. See the
# OpenSearch section of README.md before switching.
search_engine = "lucene"

# Domain shape, by the size you picked above. Starting points, not measured
# results: the per-size sizing is CLM-55930.
#
# XS (< 500 apps) and S (500 - 2,000 apps), one data node, no masters:
# opensearch_instance_type           = "m8g.large.search"
# opensearch_instance_count          = 1
# opensearch_volume_size_gb          = 50
# opensearch_availability_zone_count = 1
# opensearch_index_replicas          = 0
#
# M (2,000 - 10,000 apps), three data nodes across three zones:
# opensearch_instance_type           = "m8g.large.search"
# opensearch_instance_count          = 3
# opensearch_volume_size_gb          = 50
# opensearch_availability_zone_count = 3
# opensearch_index_replicas          = 1
#
# To use a domain you already run, set these two instead of the shape above and
# nothing is created:
# opensearch_domain_endpoint = "search-my-domain-abc123.us-east-1.es.amazonaws.com"
# opensearch_domain_name     = "my-domain"
