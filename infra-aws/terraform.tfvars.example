# Copy this file to terraform.tfvars and update the values                                                                                                                                                                                                                  
# cp terraform.tfvars.example terraform.tfvars
 
# General Configuration
aws_region  = "us-east-1"
 
# Base name for every resource this creates. Give each deployment its own value
# to run more than one in a single AWS account, one per size for example.
cluster_name = "ref-arch"
 
# Network Configuration
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs   = ["10.0.10.0/24", "10.0.20.0/24"]
db_subnet_cidrs        = ["10.0.30.0/24", "10.0.40.0/24"]
 
# ECS Configuration
ecs_cpu           = 8192  # 8 vCPU
ecs_memory        = 61440 # 60 GB, the Size M value
iq_desired_count  = 1 # Single instance (recommended)
iq_docker_image   = "sonatype/nexus-iq-server:latest"
java_opts         = "-Xms44g -Xmx44g -XX:MaxDirectMemorySize=8g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/sonatype-work/Java_Heap_logs -XX:+CrashOnOutOfMemoryError -Dinsight.threads.monitor=10 -Djava.util.prefs.userRoot=/sonatype-work/javaprefs"
 
# Database Configuration
db_name                     = "nexusiq"
db_username                 = "nexusiq"
db_password                 = "CHANGE_ME_STRONG_PASSWORD"  # Change this!
db_instance_class           = "db.r8g.2xlarge"
db_allocated_storage        = 128
db_max_allocated_storage    = 500
postgres_version            = "18.6"
db_backup_retention_period  = 7 
db_backup_window           = "03:00-04:00"
db_maintenance_window      = "sun:04:00-sun:05:00"
db_skip_final_snapshot     = true
db_deletion_protection     = false
 
# Load Balancer Configuration
# ssl_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"
alb_deletion_protection = false
 
# Logging Configuration
log_retention_days = 30

# Search Backend (optional)
# "lucene" (default) uses the index built into IQ Server and needs nothing else.
# "opensearch" creates an AWS-managed domain here and points IQ Server at it.
# The domain carries prevent_destroy, so a teardown takes these steps:
#   DOMAIN=$(terraform output -raw opensearch_domain_name)
#   terraform state rm aws_opensearch_domain.nexus_one
#   aws opensearch delete-domain --domain-name "$DOMAIN"
#   # wait for the domain to finish deleting, which releases its interfaces
#   ./tf-destroy.sh
# The state rm gets past prevent_destroy; the delete releases the private
# subnets, or destroying the VPC fails on DependencyViolation. Switching to
# lucene or to another domain takes the same steps, ending in terraform apply.
# See the OpenSearch section of README.md before switching.
#
# A VPC domain also needs the OpenSearch service-linked role in the account
# before the first apply. One command, once per account:
#   aws iam create-service-linked-role \
#     --aws-service-name opensearchservice.amazonaws.com
search_engine = "lucene"

# Domain shape, by the size you picked above. Type, count, masters and
# replicas are the measured values; storage is the published size, at or
# above the measured use.
#
# XS (< 500 apps) and S (500 - 2,000 apps), one data node, no masters.
# m8g.medium.search with 25 GB at XS, m8g.large.search with 50 GB at S:
# opensearch_instance_type           = "m8g.large.search"
# opensearch_instance_count          = 1
# opensearch_volume_size_gb          = 50
# opensearch_availability_zone_count = 1
# opensearch_index_replicas          = 0
#
# M (2,000 - 10,000 apps), three data nodes across three zones. The domain needs
# one private subnet per zone, and private_subnet_cidrs above has two, so this
# shape needs a third. Edit the private_subnet_cidrs line above rather than
# adding a second one here, which Terraform refuses as a redefined attribute,
# and pick a range no other subnet list uses: 10.0.30.0/24 is already
# db_subnet_cidrs[0]. For example:
#   private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24", "10.0.50.0/24"]
# opensearch_instance_type           = "m8g.large.search"
# opensearch_instance_count          = 3
# opensearch_volume_size_gb          = 100
# opensearch_availability_zone_count = 3
# opensearch_index_replicas          = 1
#
# An account already at the region's 10 CloudWatch Logs resource policies writes
# one policy by hand covering every domain's log groups and sets this false. The
# log groups and the domain's logs stay; only the policy is skipped, so false
# with no such policy in place fails the domain create:
# opensearch_create_log_resource_policy = false
#
# To use a domain you already run, set these two instead of the shape above and
# nothing is created:
# opensearch_domain_endpoint = "search-my-domain-abc123.us-east-1.es.amazonaws.com"
# opensearch_domain_name     = "my-domain"
