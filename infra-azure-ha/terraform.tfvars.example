# Nexus IQ Server High Availability Infrastructure Configuration
# Copy this file to terraform.tfvars and customize for your environment

# General Configuration
azure_region  = "East US 2"
cluster_name  = "ref-arch-iq-ha"

# Network Configuration (Multi-zone for HA)
vnet_cidr               = "10.0.0.0/16"
public_subnet_cidrs     = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]    # Multiple subnets for zone redundancy
private_subnet_cidrs    = ["10.0.10.0/24", "10.0.20.0/24", "10.0.30.0/24"] # Multiple subnets for zone redundancy
db_subnet_cidr          = "10.0.40.0/24"

# High Availability Container App Configuration
container_cpu          = 8.0       # vCPU per replica, the Size M and L value
container_memory       = "64Gi"    # Memory per replica, the Size M and L value
iq_min_replicas        = 2         # Minimum replicas, the Size L value (must be >= 2)
iq_max_replicas        = 4         # Maximum replicas for auto-scaling, the Size L value
# Container Apps workload profile. E8 is 8 cores and 64 GB per node, for Size M
# and L. Size XL uses E16, 16 cores and 128 GB.
workload_profile_type  = "E8"
iq_docker_image        = "sonatype/nexus-iq-server:latest"
java_opts              = "-Xms48g -Xmx48g -XX:MaxDirectMemorySize=8g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/sonatype-work/Java_Heap_logs -XX:+CrashOnOutOfMemoryError -Dinsight.threads.monitor=10 -Djava.util.prefs.userRoot=/sonatype-work/javaprefs"

# Auto Scaling Configuration
cpu_utilization_threshold     = 70    # CPU threshold for scaling (%)
memory_utilization_threshold  = 80    # Memory threshold for scaling (%)
scale_rule_concurrent_requests = 100  # Concurrent requests threshold

# Zone-Redundant Database Configuration (HA)
db_name                         = "nexusiq"
db_username                     = "nexusiq"
db_password                     = "CHANGE_ME_STRONG_PASSWORD"  # Change this!
postgres_version               = "18"
db_sku_name                    = "MO_Standard_E16ds_v6"     # Memory Optimized: 16 vCores, 128GB RAM
db_backup_retention_days       = 7
db_geo_redundant_backup_enabled = false                    # Set to true if region supports geo-redundant backups
db_high_availability_mode      = "ZoneRedundant"           # Zone-redundant HA

# Zone-Redundant Application Gateway Configuration (HA)
app_gateway_sku_name    = "Standard_v2"    # v2 required for zone redundancy
app_gateway_sku_tier    = "Standard_v2"    # v2 required for zone redundancy
app_gateway_capacity    = 2                # Number of instances
app_gateway_zones       = ["1", "2", "3"] # Availability zones

# Premium Storage Configuration (HA)
storage_account_tier            = "Standard"
storage_account_replication_type = "ZRS"     # Zone-Redundant Storage
file_share_quota_gb            = 512         # File share size in GB

# Monitoring and Logging
enable_monitoring         = true
log_retention_days       = 30
enable_container_insights = true

# Backup Configuration
enable_backup = true

# Key Vault Configuration
key_vault_sku_name                   = "standard"
key_vault_soft_delete_retention_days = 7

# Search Backend (optional)
# "lucene" (default) uses IQ Server's embedded index and needs nothing else.
# "opensearch" points IQ Server at a self-managed OpenSearch cluster you run on
# Azure Virtual Machines. This configuration does not provision that cluster,
# so its lifecycle and its indexed data stay independent of Terraform runs
# here. README.md carries the cluster specification, the build steps and the
# trust store steps a private certificate authority needs.
search_engine = "lucene"

# opensearch_endpoint       = "opensearch.internal.example.com"
# opensearch_port           = 9200
# opensearch_use_tls        = true
# opensearch_username       = "iq-server"
# opensearch_password       = "CHANGE_ME_STRONG_PASSWORD"
# opensearch_index_replicas = 1

# For a cluster whose certificate comes from a private certificate authority,
# that authority's certificate, base64 encoded. IQ Server has no per-connection
# trust setting, so the entrypoint adds it to a copy of the JVM's own trust
# store. Leave empty for a public authority. This is not a credential.
# opensearch_ca_pem = ""

# Private container registry holding iq_docker_image. Leave all three empty for
# an image on a public registry. The password is delivered to the container app
# as a secret, and belongs in terraform.tfvars, which is gitignored, never here.
# container_registry_server   = "myregistry.azurecr.io"
# container_registry_username = "myregistry"
# container_registry_password = "CHANGE_ME_REGISTRY_PASSWORD"

# Tags
# Replace every placeholder below with your own values. terraform.tfvars is
# gitignored and this example file is not, so nothing naming a person or an
# account belongs here.
#
# Azure treats tag names as case-insensitive, so do not add a second key that
# differs from one of these only in capitalization.
common_tags = {
  Environment    = "production"
  Terraform      = "true"
  DeploymentType = "high-availability"
  CostCenter     = "engineering"

  owner      = "CHANGE_ME_EMAIL"
  project    = "CHANGE_ME_PROJECT"
  subproject = "CHANGE_ME_SUBPROJECT"
  department = "CHANGE_ME_DEPARTMENT"
  team       = "CHANGE_ME_TEAM"
}