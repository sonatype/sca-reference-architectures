# Copy this file to terraform.tfvars and update the values                                                                                                                                                                                                                  
# cp terraform.tfvars.example terraform.tfvars
 
# ================================
# GENERAL CONFIGURATION
# ================================
aws_region   = "us-east-1"
cluster_name = "ref-arch-iq-ha-cluster"
 
# ================================
# NETWORK CONFIGURATION
# ================================
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs   = ["10.0.10.0/24", "10.0.20.0/24", "10.0.30.0/24"]
db_subnet_cidrs        = ["10.0.40.0/24", "10.0.50.0/24", "10.0.60.0/24"]
enable_nat_gateway     = true
 
# ================================
# ECS CONFIGURATION
# ================================
ecs_cpu                 = 8192   # 8 vCPU
ecs_memory              = 61440  # 60 GB, the Size M and L value
ecs_memory_reservation  = 53248  # 52 GB soft limit, the heap plus direct memory
 
# ================================
# IQ SERVER CONFIGURATION
# ================================
# Size L task counts. README.md gives Size M and XL.
iq_desired_count        = 3  # 3 tasks for Size L
iq_min_count           = 2  # Minimum for auto scaling
iq_max_count           = 4  # Maximum for auto scaling
iq_cpu_target_value    = 70  # CPU target for auto scaling (%) 
iq_memory_target_value = 80  # Memory target for auto scaling (%) 
iq_docker_image        = "sonatype/nexus-iq-server:latest"
java_opts              = "-Xms44g -Xmx44g -XX:MaxDirectMemorySize=8g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/sonatype-work/Java_Heap_logs -XX:+CrashOnOutOfMemoryError -Dinsight.threads.monitor=10 -Djava.util.prefs.userRoot=/sonatype-work/javaprefs"
 
# ================================
# DATABASE CONFIGURATION (Aurora PostgreSQL)
# ================================
db_name                     = "nexusiq"
db_username                 = "nexusiq"
db_password                 = "CHANGE_ME_STRONG_PASSWORD"  # CHANGE THIS!
aurora_engine_version       = "18.6"
aurora_instance_class       = "db.r8g.2xlarge"
aurora_instances            = 2  # Minimum 2 for HA
db_backup_retention_period  = 7 
db_backup_window           = "03:00-04:00"
db_maintenance_window      = "sun:04:00-sun:05:00"
db_skip_final_snapshot     = false  # Set to true for development
db_deletion_protection     = false  # Set to false for development
 
# ================================
# LOAD BALANCER CONFIGURATION
# ================================
# Uncomment and provide SSL certificate ARN for HTTPS
# ssl_certificate_arn = "arn:aws:acm:us-east-1:CHANGE_ME:certificate/CHANGE_ME"
alb_deletion_protection = false  # Set to true for production
 
# ================================
# MONITORING CONFIGURATION
# ================================
enable_container_insights = true
enable_prometheus        = true
log_retention_days       = 30
 
# ================================
# SEARCH BACKEND, needed for Advanced Search and the Nexus One index at every size
# ================================
# "lucene" (default) uses IQ Server's built-in index; "opensearch"
# creates a domain here. The domain carries prevent_destroy; README.md gives the
# teardown steps, and the account needs the OpenSearch service-linked role:
#   aws iam create-service-linked-role \
#     --aws-service-name opensearchservice.amazonaws.com
search_engine = "lucene"

# Domain shape by size, three data nodes across three zones at every size.
#
# M (2,000 - 10,000 apps):
# opensearch_instance_type           = "m8g.large.search"
# opensearch_volume_size_gb          = 100
# opensearch_dedicated_master_type   = "m8g.medium.search"
#
# L (10,000 - 20,000 apps):
# opensearch_instance_type           = "m8g.xlarge.search"
# opensearch_volume_size_gb          = 150
# opensearch_dedicated_master_type   = "m8g.medium.search"
#
# XL (20,000 - 80,000 apps):
# opensearch_instance_type           = "r8g.2xlarge.search"
# opensearch_volume_size_gb          = 250
# opensearch_dedicated_master_type   = "m8g.large.search"
#
# Every size:
# opensearch_instance_count          = 3
# opensearch_availability_zone_count = 3
# opensearch_index_replicas          = 1
#
# An account at the region's 10 log resource policies writes one shared policy
# and sets this false:
# opensearch_create_log_resource_policy = false
#
# To use a domain you already run, set these two instead and nothing is created:
# opensearch_domain_endpoint = "search-my-domain-abc123.us-east-1.es.amazonaws.com"
# opensearch_domain_name     = "my-domain"
 
# ================================
# COMMON TAGS
# ================================
common_tags = {
  Project     = "nexus-iq-server-ha"
  Environment = "production"  # or "development", "staging"
  Terraform   = "true"
  Owner       = "platform-team"
  CostCenter  = "engineering"
}
 
# ================================
# SECURITY NOTES
# ================================
# 1. Change the db_password to a strong, unique password
# 2. Consider using AWS Secrets Manager rotation for the database password
# 3. Provide an SSL certificate ARN for HTTPS termination
# 4. Restrict public access CIDRs in production
# 5. Enable deletion protection for production resources
# 6. Use specific Helm chart versions rather than "latest" in production
 
# ================================
# COST OPTIMIZATION NOTES
# ================================
# 1. ECS Fargate pricing based on vCPU and memory usage
# 2. Use smaller task sizes (ecs_cpu/ecs_memory) for development
# 3. Adjust backup retention periods based on requirements
# 4. Consider using Fargate Spot for non-production workloads
 
# ================================
# HIGH AVAILABILITY NOTES
# ================================
# 1. Minimum 2 IQ Server tasks (iq_min_count = 2)
# 2. Minimum 2 Aurora instances (aurora_instances = 2)
# 3. ECS tasks run across multiple Availability Zones
# 4. Auto scaling based on CPU and memory utilization
# 5. Service discovery for inter-task communication
# 6. Shared EFS storage for stateful data                        
