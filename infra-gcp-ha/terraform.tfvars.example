# GCP Project Configuration
gcp_project_id = "CHANGE_ME-gcp-project-id"
gcp_region     = "us-central1"

# Availability zones for multi-zone deployment
availability_zones = ["us-central1-a", "us-central1-b", "us-central1-c"]

# Environment
environment = "prod"

# Resource Naming
# Prefix for every name that must be unique in a project. Empty keeps the default
# names; set a distinct value per deployment when several share one project, for example "iq-m".
cluster_name = ""

# Network Configuration
# This root creates subnets inside an auto-created VPC, so there is no
# VPC-wide CIDR variable. Set the three subnet ranges instead.
public_subnet_cidr   = "10.200.1.0/24"
private_subnet_cidrs = ["10.200.10.0/24", "10.200.11.0/24", "10.200.12.0/24"]
db_subnet_cidr       = "10.200.20.0/24"

# Security - SSH access (restrict to your IP range)
allowed_ssh_cidrs = ["CHANGE_ME/32"] # the range allowed to SSH to the instances

# Nexus IQ Server Configuration
iq_docker_image = "sonatype/nexus-iq-server:1.209.0"

# Compute Engine Instance Configuration
instance_machine_type = "n4a-standard-8" # 8 vCPU, 32 GB (ARM)

# High Availability Configuration
# Size M instance counts. README.md gives Size L and XL.
iq_min_instances    = 2 # Minimum for HA
iq_max_instances    = 3 # Maximum for scaling
iq_target_instances = 2 # Initial target

# Database Configuration
db_name     = "nexusiq"
db_username = "nexusiq"
db_password = "CHANGE_ME_STRONG_PASSWORD" # Change this!
iq_admin_initial_password = "CHANGE_ME"  # IQ Server's admin password, at least 12 characters, read on its first start only
iq_license_file = "CHANGE_ME"  # path to your IQ Server license file (.lic), installed by every IQ Server node on its first start

# Database settings
postgres_version         = "POSTGRES_18"
db_instance_tier         = "db-custom-N4-4-32768" # 4 vCPU, 32 GB, N4 series (Enterprise)
db_edition               = "ENTERPRISE"           # ENTERPRISE_PLUS for db-perf-optimized-N-* or db-c4a-highmem-*
db_disk_type             = "HYPERDISK_BALANCED"   # the only storage the N4 tiers take
db_disk_provisioned_iops = 8000                   # 10,000 at Size XL
db_disk_provisioned_throughput = 240             # 252 MB/s, given to the API in MiB/s; 340 (357 MB/s) at Size L, 425 (446 MB/s) at Size XL, set with the IOPS
db_availability_type     = "REGIONAL"             # REGIONAL for HA, ZONAL for single-zone
db_disk_size             = 128
db_max_disk_size         = 500
db_max_connections       = "500"

# Database backup configuration
db_backup_start_time              = "03:00" # UTC time
db_transaction_log_retention_days = 7
db_backup_retention_count         = 8
db_maintenance_window_day         = 7 # Sunday
db_maintenance_window_hour        = 4 # 4 AM UTC
db_deletion_protection            = true

# Shared Storage Configuration (Cloud Filestore Regional, in gcp_region)
filestore_tier        = "REGIONAL"
filestore_capacity_gb = 500   # the Size M capacity
filestore_max_iops    = 8000

# Load Balancer and SSL Configuration
enable_ssl  = false # Set to true and provide domain_name for HTTPS
domain_name = ""    # Required if enable_ssl is true (e.g., "iq.example.com")

# Seconds the load balancer waits for IQ Server before answering 502
lb_backend_timeout_sec = 30

# Auto Scaling Configuration
cpu_target_utilization     = 0.7 # 70% CPU utilization target
scale_in_cooldown_seconds  = 300 # 5 minutes
scale_out_cooldown_seconds = 60  # 1 minute

# Java Configuration
java_opts = "-Xms20g -Xmx20g -XX:MaxDirectMemorySize=4g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/sonatype-work/heap-dump.hprof -XX:+ExitOnOutOfMemoryError -Dinsight.threads.monitor=10 -Djava.util.prefs.userRoot=/sonatype-work/javaprefs"

# Logging
log_retention_days = 30

# Extra logger levels for config.yml, for example for a support case
# iq_log_levels = { "com.sonatype.insight.brain.search" = "DEBUG" }

# Common Tags/Labels
common_tags = {
  environment = "prod"
  component   = "nexus-iq-ha"
  managed-by  = "terraform"
  team        = "platform"
  cost-center = "engineering"
}

# Search Backend, needed for Advanced Search and the Nexus One index at every size
# Required: "lucene" uses the built-in index. "opensearch" builds an OpenSearch cluster
# with this configuration, sized below.
search_engine = "CHANGE_ME"  # "opensearch" for Nexus One, or "lucene" to run without it

# The OpenSearch cluster this configuration builds. These are the Size M values; README.md
# gives every size. Passwords left unset are generated.
opensearch_data_node_count       = 3
opensearch_data_instance_type    = "c4a-standard-2"
opensearch_manager_instance_type = "c4a-standard-1"
opensearch_data_disk_gb          = 100

# To use a cluster you run yourself instead, set opensearch_create = false and these:
# opensearch_create                   = false
# opensearch_endpoint                 = "CHANGE_ME-opensearch.internal.example.com"
# opensearch_port                     = 9200
# opensearch_use_tls                  = true
# opensearch_username                 = "nexusiq"
# opensearch_password                 = "CHANGE_ME_STRONG_PASSWORD"
# opensearch_index_replicas = 1
# Only for a private certificate authority:
# opensearch_ca_certificate = <<-EOT
#   -----BEGIN CERTIFICATE-----
#   ...the authority's PEM certificate...
#   -----END CERTIFICATE-----
# EOT

# The values above are Size M. Under 2,000 applications, use infra-gcp: this root requires
# at least 2 instances. The blocks below are Size L and XL.

# Size L:
# instance_machine_type = "n4a-standard-16"    # 16 vCPU, 64 GB (ARM)
# iq_min_instances      = 2
# iq_max_instances      = 4
# iq_target_instances   = 2
# db_instance_tier      = "db-custom-N4-8-65536" # 8 vCPU, 64 GB (Enterprise)
# db_disk_provisioned_iops = 8000
# db_disk_provisioned_throughput = 340
# db_availability_type  = "REGIONAL"
# db_disk_size          = 256
# db_max_disk_size      = 1000  # the Size M value above is 500
# filestore_capacity_gb = 1536                # the Size M value above is 500
# filestore_max_iops    = 16000
# opensearch_data_instance_type = "c4a-standard-4"
# opensearch_data_disk_gb       = 150
# java_opts             = "-Xms42g -Xmx42g -XX:MaxDirectMemorySize=8g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/sonatype-work/heap-dump.hprof -XX:+ExitOnOutOfMemoryError -Dinsight.threads.monitor=10 -Djava.util.prefs.userRoot=/sonatype-work/javaprefs"

# Size XL:
# instance_machine_type = "n4a-highmem-16"     # 16 vCPU, 128 GB (ARM)
# iq_min_instances      = 3
# iq_max_instances      = 5
# iq_target_instances   = 3
# db_instance_tier      = "db-custom-N4-16-131072" # 16 vCPU, 128 GB (Enterprise)
# db_disk_provisioned_iops = 10000
# db_disk_provisioned_throughput = 425
# db_availability_type  = "REGIONAL"
# db_disk_size          = 512
# db_max_disk_size      = 2000  # the Size M value above is 500
# filestore_capacity_gb = 4096                # 4 TB
# filestore_max_iops    = 24000
# opensearch_data_instance_type    = "c4a-highmem-8"
# opensearch_manager_instance_type = "c4a-standard-2"
# opensearch_data_disk_gb          = 250
# java_opts             = "-Xms85g -Xmx85g -XX:MaxDirectMemorySize=8g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/sonatype-work/heap-dump.hprof -XX:+ExitOnOutOfMemoryError -Dinsight.threads.monitor=10 -Djava.util.prefs.userRoot=/sonatype-work/javaprefs"
